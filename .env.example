# Порт, на котором публикуется веб-панель и API
API_PORT=8000

# Токен приёма телеметрии. Если оставить пустым, эндпоинт /api/uplink открыт.
# В рабочем контуре задаётся и прописывается в HTTP-интеграции ChirpStack.
INGEST_TOKEN=

# Интервал передачи эмулятора буёв, секунд
SIM_INTERVAL=10

# Таймаут перевода буя в состояние «офлайн», секунд
OFFLINE_AFTER_SEC=600

# Наименование шлюза LoRaWAN, отображаемое в панели
GATEWAY_NAME=BS-AKTAU
